<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tv_detail_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="Đang xác định Xã/Phường..."
            android:textColor="#F8FAFC"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_detail_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="--°C"
            android:textColor="#38BDF8"
            android:textSize="72sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_detail_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Mưa dông &amp; Sấm chớp"
            android:textColor="#CBD5E1"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tv_detail_wind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Sức gió: -- km/h"
            android:textColor="#94A3B8"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_trigger_storm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:backgroundTint="#1E293B"
            android:text="⚡ Kích hoạt sấm chớp"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <com.example.transparentweather.WeatherEffectView
        android:id="@+id/weather_effect_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
